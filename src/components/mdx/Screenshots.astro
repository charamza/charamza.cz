---
interface ScreenshotItem {
  src?: string;
  alt?: string;
  placeholder?: string;
}

interface Props {
  label?: string;
  caption?: string;
  items: ScreenshotItem[];
}

const { label = "SCREENSHOTS", caption, items } = Astro.props;
---

<div class="screenshots-block">
  <div class="section-label"><span>{label}</span></div>
  <div class="screenshots-grid">
    {
      items.map((item) =>
        item.src ? (
          <div class="screenshot-frame">
            <img src={item.src} alt={item.alt ?? ""} />
          </div>
        ) : (
          <div class="screenshot-placeholder">{item.placeholder}</div>
        ),
      )
    }
  </div>
  {caption && <p class="screenshots-caption" set:html={caption} />}
</div>

<style>
  .screenshots-block {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .screenshots-grid {
    display: flex;
    gap: 24px;
  }

  .screenshot-frame {
    flex: 1;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-primary);
  }

  .screenshot-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .screenshot-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    height: 360px;
    border-radius: 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border-primary);
    font-size: 14px;
    color: var(--text-muted);
  }

  .screenshots-caption {
    font-size: 13px !important;
    font-weight: 400 !important;
    color: var(--text-muted) !important;
    line-height: 1.5 !important;
  }

  @media (max-width: 768px) {
    .screenshots-grid {
      flex-direction: column;
    }

    .screenshot-placeholder {
      height: 200px;
      min-height: 200px;
    }
  }
</style>
