---
interface MetricItem {
  value: string;
  label: string;
}

interface Props {
  label?: string;
  items: MetricItem[];
  withoutBottom?: boolean;
}

const { label = "METRICS", items } = Astro.props;
---

<div class="metrics-block">
  <div class="section-label"><span>{label}</span></div>
  <div class="metrics-grid">
    {
      items.map((item) => (
        <div class="metric">
          <span class="metric-value">{item.value}</span>
          <span class="metric-label">{item.label}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .metrics-block {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .metrics-grid {
    display: flex;
    gap: 24px;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .metric-value {
    font-family: "Newsreader", serif;
    font-size: 40px;
    font-weight: 500;
    color: var(--amber);
  }

  .metric-label {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-tertiary);
  }

  @media (max-width: 768px) {
    .metrics-grid {
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
