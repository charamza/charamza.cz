---
import { getCollection } from "astro:content";
import FooterBlock from "../../components/FooterBlock.astro";
import Nav from "../../components/Nav.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allWork = await getCollection("work");

// Parse "February 2025" → Date for sorting
function parseStartDate(s: string | undefined): Date {
  if (!s) return new Date(0);
  const d = new Date(s);
  return isNaN(d.getTime()) ? new Date(0) : d;
}

const sorted = [...allWork].sort(
  (a, b) => parseStartDate(b.data.startDate).getTime() - parseStartDate(a.data.startDate).getTime(),
);

// Group by year
const byYear = new Map<number, typeof sorted>();
for (const entry of sorted) {
  const d = parseStartDate(entry.data.startDate);
  const year = d.getFullYear() || 0;
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(entry);
}

// Sorted years descending
const years = [...byYear.keys()].sort((a, b) => b - a);

function monthLabel(s: string | undefined): string {
  if (!s) return "";
  const d = new Date(s);
  if (isNaN(d.getTime())) return "";
  return d.toLocaleString("en-US", { month: "short" }).toUpperCase();
}

const statusLabel: Record<string, string> = {
  active: "Active",
  paused: "Paused",
  archived: "Archived",
};
---

<BaseLayout title="Case studies — Honza Charamza">
  <Nav variant="blog" />

  <section class="work-header">
    <div class="section-label"><span>CASE STUDIES</span></div>
    <h1 class="work-title">Selected Work</h1>
    <p class="work-desc">A collection of projects and case studies — from random experiments to product design.</p>
  </section>

  <div class="divider"></div>

  <div class="timeline">
    {
      years.map((year) => (
        <div class="year-group">
          <div class="year-marker">
            <span class="year-number">{year || "—"}</span>
          </div>
          <div class="year-entries">
            {byYear.get(year)!.map((entry) => {
              const { title, subtitle, tags, coverImage, coverImagePosition, status, startDate, readTime } = entry.data;
              const month = monthLabel(startDate);
              return (
                <a href={`/blog/${entry.slug}`} class="entry-card">
                  <div class="entry-month">{month}</div>
                  <div class="entry-body">
                    <div class="entry-cover">
                      {coverImage ? (
                        <img
                          src={coverImage}
                          alt={title}
                          style={coverImagePosition ? `object-position: ${coverImagePosition}` : undefined}
                        />
                      ) : (
                        <div class="entry-cover-placeholder" />
                      )}
                    </div>
                    <div class="entry-info">
                      <div class="entry-top">
                        <div class="entry-tags">
                          {tags.map((tag: string) => (
                            <span class="tag">{tag}</span>
                          ))}
                        </div>
                      </div>
                      <h2 class="entry-title">{title}</h2>
                      <p class="entry-subtitle">{subtitle}</p>
                      <span class="entry-link">
                        {readTime && <span class="entry-read-time">{readTime}</span>}
                        <span class="entry-cta">Read case study →</span>
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>

  <div class="footer-wrap">
    <FooterBlock />
  </div>
</BaseLayout>

<style>
  /* ===== Header ===== */
  .work-header {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 64px 32px 56px;
    max-width: 1200px;
    margin-inline: auto;
    width: 100%;
  }

  .work-title {
    font-family: "Newsreader", serif;
    font-size: 56px;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .work-desc {
    font-family: "Newsreader", serif;
    font-size: 20px;
    font-weight: 400;
    color: var(--text-tertiary);
    line-height: 1.6;
    max-width: 560px;
  }

  /* ===== Timeline ===== */
  .timeline {
    display: flex;
    flex-direction: column;
    max-width: 1200px;
    margin-inline: auto;
    width: 100%;
    padding: 0 32px;
  }

  .year-group {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 0 48px;
    padding-block: 48px;
    border-bottom: 1px solid var(--border-divider);
  }

  .year-group:last-child {
    border-bottom: none;
  }

  .year-marker {
    display: flex;
    justify-content: flex-end;
    padding-top: 6px;
  }

  .year-number {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--amber);
  }

  .year-entries {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* ===== Entry card ===== */
  .entry-card {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 0 24px;
    cursor: pointer;
  }

  .entry-card:hover .entry-title {
    color: var(--amber);
  }

  /* .entry-card:hover .entry-cover img,
  .entry-card:hover .entry-cover-placeholder {
    opacity: 0.85;
  } */

  .entry-month {
    padding-top: 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    text-align: right;
  }

  .entry-body {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 32px;
    border-radius: 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border-primary);
    overflow: hidden;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .entry-card:hover .entry-body {
    /* border-color: var(--amber); */
    /* box-shadow: 0 4px 24px rgba(217, 119, 6, 0.08); */
  }

  .entry-cover {
    overflow: hidden;
    flex-shrink: 0;
  }

  .entry-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s;
  }

  .entry-cover-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a1a1a, #374151);
    transition: opacity 0.2s;
  }

  .entry-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px 28px 28px 0;
    justify-content: center;
  }

  .entry-top {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .entry-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .entry-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
    margin-left: auto;
  }

  .entry-status .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  .entry-title {
    font-family: "Newsreader", serif;
    font-size: 24px;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.2;
    transition: color 0.2s;
  }

  .entry-subtitle {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-tertiary);
    line-height: 1.6;
    max-width: 480px;
  }

  .entry-link {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 4px;
  }

  .entry-read-time {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .entry-cta {
    font-size: 14px;
    font-weight: 500;
    color: var(--amber);
  }

  /* ===== Footer ===== */
  .footer-wrap {
    max-width: 1200px;
    margin-inline: auto;
    padding: 48px 32px;
    width: 100%;
  }

  /* ===== Responsive ===== */
  @media (max-width: 900px) {
    .entry-body {
      grid-template-columns: 200px 1fr;
    }
  }

  @media (max-width: 768px) {
    .work-header {
      padding: 48px 24px 40px;
      gap: 20px;
    }

    .work-title {
      font-size: 40px;
    }

    .work-desc {
      font-size: 17px;
    }

    .timeline {
      padding: 0 24px;
    }

    .year-group {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-block: 36px;
    }

    .year-marker {
      justify-content: flex-start;
    }

    .entry-card {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .entry-month {
      text-align: left;
      padding-top: 0;
    }

    .entry-body {
      grid-template-columns: 1fr;
    }

    .entry-cover {
      height: 200px;
    }

    .entry-info {
      padding: 20px 20px 24px;
    }

    .entry-title {
      font-size: 20px;
    }

    .footer-wrap {
      padding: 32px 24px;
    }
  }
</style>
