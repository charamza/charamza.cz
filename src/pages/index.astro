---
import { getCollection } from "astro:content";
import FooterBlock from "../components/FooterBlock.astro";
import Nav from "../components/Nav.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredWorks = (await getCollection("work")).filter((work) => work.data.featuredIndex !== undefined);

const sortedFeaturedWorks = featuredWorks.sort((a, b) => a.data.featuredIndex! - b.data.featuredIndex!);

type WorkEntry = (typeof sortedFeaturedWorks)[0];
type CardRow = { type: "row"; items: WorkEntry[] } | { type: "horizontal"; item: WorkEntry };

const cardRows: CardRow[] = [];
let currentRow: WorkEntry[] = [];
for (const work of sortedFeaturedWorks) {
  if (work.data.featuredLayout === "horizontal") {
    if (currentRow.length > 0) {
      cardRows.push({ type: "row", items: [...currentRow] });
      currentRow = [];
    }
    cardRows.push({ type: "horizontal", item: work });
  } else {
    currentRow.push(work);
    if (currentRow.length === 2) {
      cardRows.push({ type: "row", items: [...currentRow] });
      currentRow = [];
    }
  }
}
if (currentRow.length > 0) cardRows.push({ type: "row", items: currentRow });
---

<BaseLayout title="Honza Charamza — Software Engineer">
  <Nav />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-top">
      <span class="hero-wave">👋</span>
    </div>
    <div class="hero-name-block">
      <h1 class="hero-name">Honza Charamza</h1>
      <div class="hero-title-row">
        <div class="hero-dash"></div>
        <span class="hero-title">Software Engineer</span>
      </div>
    </div>
    <p class="hero-intro">I build things. They ship.</p>
    <a href="#contact" class="hero-cta">Get in touch →</a>
  </section>

  <!-- <div class="divider"></div> -->

  <!-- About -->
  <section class="about" id="about">
    <div class="section-label"><span>ABOUT</span></div>
    <div class="about-content">
      <div class="about-left">
        <p>
          I'm a software engineer based in Prague. By day I build web and mobile applications, by night I mass consume
          coffee and build some more.
        </p>
        <p>
          I've been building software since I was a kid, long before it became a career. These days I care less about
          the code itself and more about the whole picture: does it solve a real problem, does it feel right to use,
          could it sustain itself?
        </p>
      </div>
      <div class="about-right">
        <div class="stat">
          <span class="stat-label">LOCATION</span>
          <span class="stat-value">Prague, CZ</span>
        </div>
        <div class="stat">
          <span class="stat-label">EXPERIENCE</span>
          <span class="stat-value">8+ years</span>
        </div>
        <div class="stat">
          <span class="stat-label">FOCUS</span>
          <span class="stat-value">Web &amp; Mobile Apps</span>
        </div>
        <div class="stat">
          <span class="stat-label">AVAILABLE</span>
          <span class="stat-value stat-available">
            <span class="dot"></span>
            Open to opportunities
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- <div class="divider"></div> -->

  <!-- Work -->
  <section class="work" id="work">
    <div class="section-label"><span>SELECTED WORK</span></div>
    <p class="work-subtitle">A few projects I've worked on recently.</p>
    <div class="cards-grid">
      {
        cardRows.map((row) =>
          row.type === "row" ? (
            <div class="cards-row">
              {row.items.map((work) => (
                <a href={`/blog/${work.slug}`} class="card">
                  <div class={`card-image gradient-amber`} style={`background-image: url(${work.data.coverImage})`} />
                  <div class="card-content">
                    <div class="card-tags">
                      {work.data.tags.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                    <h3 class="card-title" set:html={work.data.title} />
                    <p class="card-desc">{work.data.subtitle}</p>
                    <div class="spacer" />
                    <span class="card-link">View case study →</span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <a href={`/blog/${row.item.slug}`} class="card card-horizontal">
              <div class={`card-image gradient-amber`} style={`background-image: url(${row.item.data.coverImage})`} />
              <div class="card-content">
                <div class="card-tags">
                  {row.item.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <h3 class="card-title" set:html={row.item.data.title} />
                <p class="card-desc">{row.item.data.subtitle}</p>
                <div class="spacer" />
                <span class="card-link">View case study →</span>
              </div>
            </a>
          ),
        )
      }
    </div>
  </section>

  <!-- <div class="divider"></div> -->

  <!-- Contact & Footer -->
  <section class="contact" id="contact">
    <div class="contact-top">
      <div class="contact-label">
        <div class="line"></div>
        <span>GET IN TOUCH</span>
        <div class="line"></div>
      </div>
      <div class="contact-text">
        <h2 class="contact-title">Let's work together</h2>
        <p class="contact-desc">
          Have an interesting project or just want to chat about engineering and design? I'd love to hear from you.
        </p>
      </div>
      <div class="contact-email">
        <a href="mailto:honza@charamza.cz" class="contact-email-link">honza@charamza.cz</a>
      </div>
    </div>

    <FooterBlock />
  </section>
</BaseLayout>

<style>
  /* ===== Hero ===== */
  .hero {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 40px 32px;
    max-width: 1200px;
    margin-inline: auto;
    width: 100%;
    min-height: 70vh;
    justify-content: center;
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hero-wave {
    font-size: 52px;
    line-height: 1;
  }

  .hero-name-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-name {
    font-family: "Newsreader", serif;
    font-size: 72px;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.05;
  }

  .hero-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hero-dash {
    width: 40px;
    height: 3px;
    border-radius: 2px;
    background: var(--amber);
  }

  .hero-title {
    font-size: 24px;
    font-weight: 400;
    color: var(--text-secondary);
  }

  .hero-intro {
    font-size: 18px;
    font-weight: 400;
    color: var(--text-tertiary);
    line-height: 1.6;
    max-width: 600px;
  }

  .hero-cta {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    border-radius: 100px;
    background: var(--amber);
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.3px;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(217, 119, 6, 0.25);
    transition: box-shadow 0.5s;
  }

  .hero-cta:hover {
    box-shadow: 0 6px 24px rgba(217, 119, 6, 0.35);
  }

  /* ===== About ===== */
  .about {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 64px 32px;
    max-width: 1200px;
    margin-inline: auto;
    width: 100%;
  }

  .about-content {
    display: flex;
    gap: 80px;
  }

  .about-left {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 600px;
    flex-shrink: 0;
  }

  .about-left p {
    font-family: "Newsreader", serif;
    font-size: 20px;
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .about-right {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--text-muted);
  }

  .stat-value {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .stat-available {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .stat-available .dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: #22c55e;
  }

  /* ===== Work ===== */
  .work {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 64px 32px;
    max-width: 1200px;
    margin-inline: auto;
    width: 100%;
  }

  .work-subtitle {
    font-family: "Newsreader", serif;
    font-size: 22px;
    font-weight: 400;
    color: var(--text-secondary);
  }

  .cards-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cards-row {
    display: flex;
    gap: 24px;
  }

  .card {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border-primary);
    overflow: hidden;
    flex: 1;
  }

  .card-image {
    height: 220px;
    position: relative;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    display: flex;
    align-items: flex-start;
    padding: 0;
  }

  .card-image-label {
    position: absolute;
    top: 24px;
    left: 24px;
    font-family: "JetBrains Mono", monospace;
    font-size: 28px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.25);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    flex: 1;
  }

  .card-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .card-title {
    font-family: "Newsreader", serif;
    font-size: 22px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .card-desc {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--amber);
    transition: gap 0.2s;
  }

  .card-link:hover {
    gap: 12px;
  }

  .card-horizontal {
    flex-direction: row;
  }

  .card-horizontal .card-image {
    width: 480px;
    height: auto;
    min-height: 100%;
    flex-shrink: 0;
  }

  .card-horizontal .card-content {
    padding: 32px;
    justify-content: center;
  }

  .gradient-amber {
    background-image: linear-gradient(135deg, #f59e0b, #d97706);
  }

  /* ===== Contact ===== */
  .contact {
    display: flex;
    flex-direction: column;
    gap: 64px;
    padding: 40px 32px;
    max-width: 1200px;
    margin-inline: auto;
    width: 100%;
  }

  .contact-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding-block: 48px;
  }

  .contact-label {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .contact-label .line {
    width: 60px;
    height: 1px;
    background: var(--border-primary);
  }

  .contact-label span {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--amber);
  }

  .contact-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .contact-title {
    font-family: "Newsreader", serif;
    font-size: 36px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .contact-desc {
    font-size: 16px;
    font-weight: 400;
    color: var(--text-tertiary);
    line-height: 1.6;
    max-width: 480px;
  }

  .contact-email {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .contact-email-link {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    font-weight: 600;
    color: var(--amber);
    padding: 14px 32px;
    border-radius: 8px;
  }

  /* ===== Responsive — Mobile (< 768px) ===== */
  @media (max-width: 768px) {
    .hero {
      padding: 80px 24px 48px;
      gap: 24px;
    }

    .hero-name {
      font-size: 48px;
    }

    .hero-title {
      font-size: 18px;
    }

    .hero-intro {
      font-size: 16px;
      max-width: 100%;
    }

    .about {
      padding: 48px 24px;
      gap: 32px;
    }

    .about-content {
      flex-direction: column;
      gap: 40px;
    }

    .about-left {
      width: 100%;
    }

    .about-left p {
      font-size: 18px;
    }

    .work {
      padding: 48px 24px;
      gap: 32px;
    }

    .work-subtitle {
      font-size: 18px;
    }

    .cards-row {
      flex-direction: column;
    }

    .card-horizontal {
      flex-direction: column;
    }

    .card-horizontal .card-image {
      width: 100%;
      height: 220px;
    }

    .contact {
      padding: 32px 24px 24px;
      gap: 48px;
    }

    .contact-title {
      font-size: 28px;
    }
  }
</style>
